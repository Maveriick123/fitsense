<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad y transferencia para Android 12+ (android:dataExtractionRules).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- La calibración depende del sensor de ESTE móvil: ni copia en la nube ni transferencia
         a un móvil nuevo, porque allí los umbrales no serían válidos. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="fitsense_calibration.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fitsense_calibration.xml" />
    </device-transfer>
</data-extraction-rules>
